# Copy this file to .enterprise-config/openclaw.env and replace placeholders.
# The destination is Git-ignored. Store identifiers only, never secrets or tokens.

# local or remote
AWS_VPC_FLOW_CONNECTION_MODE=local

# Local development mode
AWS_VPC_FLOW_WORKSPACE_ID=<workspace-customer-id>
AWS_VPC_FLOW_SUBSCRIPTION_ID=<subscription-id>
AWS_VPC_FLOW_AZURE_AUTH_MODE=azure-cli

# Existing enterprise MCP mode
AWS_VPC_FLOW_MCP_URL=
AWS_VPC_FLOW_MCP_SCOPE=aws_vpc_flow.read
AWS_VPC_FLOW_OPENCLAW_AUTH_PROFILE=
AWS_VPC_FLOW_APPROVED_AGENT_IDS=
