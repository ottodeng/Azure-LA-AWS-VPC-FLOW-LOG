AWS_VPC_FLOW_WORKSPACE_ID=<workspace-customer-id>
AWS_VPC_FLOW_SUBSCRIPTION_ID=<subscription-id>
AWS_VPC_FLOW_AZURE_AUTH_MODE=managed-identity

AWS_VPC_FLOW_MCP_AUTH_MODE=entra
AWS_VPC_FLOW_MCP_TENANT_ID=<tenant-id>
AWS_VPC_FLOW_MCP_AUDIENCE=api://<mcp-api-application-id>
AWS_VPC_FLOW_MCP_SCOPE=aws_vpc_flow.read
AWS_VPC_FLOW_MCP_SERVER_URL=https://<mcp-host>/mcp

AWS_VPC_FLOW_ACCESS_POLICY=/app/config/access-policy.example.json
AWS_VPC_FLOW_AUDIT_LOG=/var/log/aws-vpc-flow-mcp/audit.jsonl
AWS_VPC_FLOW_AUDIT_INCLUDE_UPN=false

AWS_VPC_FLOW_DEFAULT_TIMESPAN_HOURS=24
AWS_VPC_FLOW_MAX_TIMESPAN_HOURS=720
AWS_VPC_FLOW_MAX_ROWS=2000
AWS_VPC_FLOW_QUERY_TIMEOUT_SECONDS=60

AWS_VPC_FLOW_ALLOWED_HOSTS=<mcp-host>
AWS_VPC_FLOW_ALLOWED_ORIGINS=https://<openclaw-host>
AWS_VPC_FLOW_LOG_LEVEL=INFO
